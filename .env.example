# Copy this file to .env for local runs. On Render, set the same
# values under Web Service > Environment instead.
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=attend
DB_PORT=3306
# Set true for managed MySQL providers that require SSL (Aiven, Railway, etc.)
DB_SSL=false
# Optional app-key gate. Keep identical in Render env and in the API Secret box.
# Leave empty: bearer tokens are the real auth and this value is visible in the browser.
API_SECRET=
# Optional comma-separated browser origins when frontend is NOT served by this
# service (e.g. https://user.github.io). Empty = same-origin only (no CORS headers).
CORS_ORIGIN=
# Session lifetimes in seconds (defaults shown)
TOKEN_TTL_ORGANIZER=3600
TOKEN_TTL_ADMIN=3600
TOKEN_TTL_EMPLOYEE=900
PORT=3000
